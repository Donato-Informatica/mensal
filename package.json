{
  "name": "mensal",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": "Eduardo DONATO",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build:web": "npm run -w @mensal/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:boundaries": "depcruise packages apps",
    "typecheck": "tsc && npm run typecheck --workspaces --if-present",
    "migrate": "npm run -w @mensal/database migrate",
    "seed": "npm run -w @mensal/api seed",
    "studio": "npm run -w @mensal/database studio",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run lint:boundaries && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
