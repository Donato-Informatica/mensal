# Copy to .env for local development.
DATABASE_URL=postgres://mensal:mensal@localhost:5432/mensal
# Public origin the app is served from: the web app's origin, since /api is
# reached through it (the Vite dev server proxies /api here; PRD §8.4).
BETTER_AUTH_URL=http://localhost:5173
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
PORT=3000
