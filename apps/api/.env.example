# Copy to .env for local development.
DATABASE_URL=postgres://mensal:mensal@localhost:5432/mensal
# Public origin the app is served from: the web app's origin, since /api is
# reached through it (the Vite dev server proxies /api here; PRD §8.4).
BETTER_AUTH_URL=http://localhost:5173
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
PORT=3000
# Email through Resend (ADR-0003): set both, or neither to print emails to the
# log instead. The sender's domain must be verified in Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Mensal <nao-responda@your-domain>
# Traces (PRD §8.7, ADR-0007): off unless set. `docker compose up -d` starts
# Grafana on http://localhost:3001 (no login) with a Collector on :4318; browse
# traces in Explore with the Tempo data source.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# deployment.environment on every span; "local" when unset.
# DEPLOYMENT_ENVIRONMENT=local
