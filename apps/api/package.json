{
  "name": "@mensal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.example --env-file-if-exists=.env --import ./src/instrumentation.ts --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import ./src/instrumentation.ts src/server.ts",
    "seed": "node --env-file-if-exists=.env.example --env-file-if-exists=.env src/seed-cli.ts",
    "typecheck": "tsc",
    "auth:generate": "auth generate --config auth.config.ts --output ../../packages/database/lib/schema/auth.ts --yes && prettier --write ../../packages/database/lib/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@mensal/database": "^1.0.0",
    "@mensal/shared": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@scalar/api-reference": "^1.75.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "ajv": "^8.20.0",
    "auth": "^1.7.12"
  }
}
