{
  "name": "@mensal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.example --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "auth:generate": "auth generate --config auth.config.ts --output ../../packages/database/lib/schema/auth.ts --yes && prettier --write ../../packages/database/lib/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@mensal/database": "^1.0.0",
    "@mensal/shared": "^1.0.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "auth": "^1.7.7"
  }
}
