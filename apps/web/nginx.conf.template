server {
  listen 80;
  root /usr/share/nginx/html;

  # Same origin as the SPA (PRD §8.4): no CORS. Coolify's proxy sits in front
  # and sets X-Forwarded-*; pass them on, since Better-Auth rate-limits by the
  # client IP in x-forwarded-for (PRD §8.6). ${API_HOST} is filled in when the
  # container starts (nginx image templates; see docker-compose.prod.yml).
  location /api/ {
    proxy_pass http://${API_HOST}:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # Hashed build assets never change under the same name.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # Single-page app: unknown paths go to the client router.
  location / {
    try_files $uri /index.html;
  }
}
