{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Bundled by Vite, not run by Node.
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  // A worker, type-checked by tsconfig.sw.json.
  "exclude": ["src/sw.ts", "node_modules"]
}
